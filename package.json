{
  "name": "opsdeck",
  "version": "1.5.3",
  "private": true,
  "description": "OpsDeck — Operations Studio: a premium desktop control plane for Docker with a complete interactive Docker Academy, built to host Kubernetes, databases and observability workspaces.",
  "author": {
    "name": "Ali Soltani",
    "email": "alisoltanics@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "smoke": "electron . --smoke-test",
    "test": "node scripts/test.js",
    "pack": "electron-builder --dir",
    "install:desktop": "node scripts/install-desktop.js",
    "uninstall:desktop": "node scripts/install-desktop.js --uninstall",
    "package": "electron-builder --dir && node scripts/install-desktop.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "mongodb": "^6.22.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/alisoltanics/opsdeck"
}
