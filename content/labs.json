      "id": "lab-first-contact",
      "title": "First contact",
      "subtitle": "Run, inspect and remove a container",
      "level": "Beginner",
      "duration": "8 min",
      "icon": "play",
      "accent": "green",
      "description": "A five-step introduction to the container lifecycle using images that are already approved for the sandbox.",
      "objectives": [
        "Run a detached container",
        "Read its state with docker ps",
        "Read logs and remove it cleanly"
      ],
      "steps": [
        {
          "instruction": "Run hello-world and read the output.",
          "command": "docker run --rm hello-world",
          "hint": "The image prints a short explanation and exits.",
          "expect": "docker run --rm hello-world",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Run an nginx container named lab-web in the background.",
          "command": "docker run -d --name lab-web nginx:1.27-alpine",
          "hint": "",
          "expect": "docker run -d --name lab-web nginx:1.27-alpine",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Confirm it is running.",
          "command": "docker ps",
          "hint": "Look for lab-web and its published port.",
          "expect": "docker ps",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Read the container logs.",
          "command": "docker logs lab-web",
          "hint": "nginx logs requests and startup messages.",
          "expect": "docker logs lab-web",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Remove the container.",
          "command": "docker rm -f lab-web",
          "hint": "Force removal stops the running container first.",
          "expect": "docker rm -f lab-web",
          "output": null,
          "file": null,
          "content": null
        }
      ],
      "notes": [
        "The lab adds resource limits, drops capabilities and applies an opsdeck.lab label automatically."
      ]
