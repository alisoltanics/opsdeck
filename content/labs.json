          "instruction": "Inspect the network.",
          "command": "docker network inspect lab-net",
          "hint": "",
          "expect": "docker network inspect lab-net",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Clean up the container and network.",
          "command": "docker rm -f lab-cache",
          "hint": "",
          "expect": "docker rm -f lab-cache",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Remove the network.",
          "command": "docker network rm lab-net",
          "hint": "",
          "expect": "docker network rm lab-net",
          "output": null,
          "file": null,
          "content": null
        }
      ],
      "notes": [
        "The default bridge does not provide name resolution. Always create a user-defined network for services."
