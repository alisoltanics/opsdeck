    {
      "id": "lab-diagnose",
      "title": "Diagnose a failure",
      "subtitle": "Exit codes, logs and evidence",
      "level": "Advanced",
      "duration": "12 min",
      "icon": "wrench",
      "accent": "amber",
      "description": "Reproduce a failing container and use evidence to explain it without guessing.",
      "objectives": [
        "Reproduce a non-zero exit",
        "Read the exit code and error",
        "Recover and clean up"
      ],
      "steps": [
        {
          "instruction": "Run a container that exits immediately.",
          "command": "docker run --name lab-fail alpine sh -c \"echo boom >&2; exit 7\"",
          "hint": "It exits with code 7.",
          "expect": "docker run --name lab-fail alpine sh -c \"echo boom >&2; exit 7\"",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "List all containers.",
          "command": "docker ps -a",
          "hint": "lab-fail is in the Exited state.",
          "expect": "docker ps -a",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Read the exit code.",
          "command": "docker inspect lab-fail --format '{{.State.ExitCode}}'",
          "hint": "Inspect is the source of truth, not the log text.",
          "expect": "docker inspect lab-fail --format '{{.State.ExitCode}}'",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Read the logs.",
          "command": "docker logs lab-fail",
          "hint": "stderr is included by default.",
          "expect": "docker logs lab-fail",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Run a corrected command.",
          "command": "docker run --rm alpine sh -c \"echo recovered\"",
          "hint": "A new container is the normal recovery path.",
          "expect": "docker run --rm alpine sh -c \"echo recovered\"",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Remove the failed container.",
          "command": "docker rm lab-fail",
          "hint": "",
          "expect": "docker rm lab-fail",
          "output": null,
          "file": null,
          "content": null
        }
      ],
      "notes": [
        "Exit 137 usually means SIGKILL or an OOM kill. Exit 127 means the command was not found."
      ]
