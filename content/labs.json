    {
      "id": "lab-lifecycle",
      "title": "Lifecycle control",
      "subtitle": "Stop, start and inspect state",
      "level": "Beginner",
      "duration": "7 min",
      "icon": "rotate-cw",
      "accent": "blue",
      "description": "Practice graceful stop and restart while watching the recorded state and exit code.",
      "objectives": [
        "Stop a container without deleting it",
        "Start it again",
        "Inspect the recorded exit code"
      ],
      "steps": [
        {
          "instruction": "Create a named background container.",
          "command": "docker run -d --name lab-cycle alpine sleep 600",
          "hint": "The command keeps PID 1 alive for ten minutes.",
          "expect": "docker run -d --name lab-cycle alpine sleep 600",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Stop it gracefully.",
          "command": "docker stop lab-cycle",
          "hint": "SIGTERM is sent first; the process exits.",
          "expect": "docker stop lab-cycle",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Show all containers including stopped ones.",
          "command": "docker ps -a",
          "hint": "lab-cycle is now Exited (0).",
          "expect": "docker ps -a",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Inspect the exit code.",
          "command": "docker inspect lab-cycle --format '{{.State.ExitCode}}'",
          "hint": "A graceful stop records exit code 0.",
          "expect": "docker inspect lab-cycle --format '{{.State.ExitCode}}'",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Start it again.",
          "command": "docker start lab-cycle",
          "hint": "Starting preserves the writable layer.",
          "expect": "docker start lab-cycle",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Clean up.",
          "command": "docker rm -f lab-cycle",
          "hint": "",
          "expect": "docker rm -f lab-cycle",
          "output": null,
          "file": null,
          "content": null
        }
      ],
      "notes": []
    },
