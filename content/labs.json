    {
      "id": "lab-volumes",
      "title": "Persistent volumes",
      "subtitle": "Data that survives a container",
      "level": "Intermediate",
      "duration": "10 min",
      "icon": "database",
      "accent": "orange",
      "description": "Create a named volume, write data from one container and read it back from a different one.",
      "objectives": [
        "Create a labelled volume",
        "Write data as a non-root user",
        "Prove the data survives container removal"
      ],
      "steps": [
        {
          "instruction": "Create a named volume.",
          "command": "docker volume create lab-data",
          "hint": "",
          "expect": "docker volume create lab-data",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Write a file into the volume.",
          "command": "docker run --rm -v lab-data:/data alpine sh -c \"echo persisted > /data/hello.txt\"",
          "hint": "Named volumes are mounted by name, not by host path.",
          "expect": "docker run --rm -v lab-data:/data alpine sh -c \"echo persisted > /data/hello.txt\"",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Read it from a brand-new container.",
          "command": "docker run --rm -v lab-data:/data alpine cat /data/hello.txt",
          "hint": "",
          "expect": "docker run --rm -v lab-data:/data alpine cat /data/hello.txt",
          "output": "persisted",
          "file": null,
          "content": null
        },
        {
          "instruction": "Inspect the volume.",
          "command": "docker volume inspect lab-data",
          "hint": "The mountpoint is on the Docker host, not in your home directory.",
          "expect": "docker volume inspect lab-data",
          "output": null,
          "file": null,
          "content": null
        },
        {
          "instruction": "Remove the volume.",
          "command": "docker volume rm lab-data",
          "hint": "Removal is irreversible. In production, back up first.",
          "expect": "docker volume rm lab-data",
          "output": null,
          "file": null,
          "content": null
        }
      ],
      "notes": []
    },
