{
  "diagrams": {
    "docker-architecture": {
      "title": "Docker architecture",
      "description": "The CLI talks to the daemon over an API. The daemon stores images and delegates container execution to containerd, shims and runc.",
      "width": 960,
      "height": 440,
      "nodes": [
        {
          "id": "client",
          "label": "Docker CLI",
          "sub": "docker run / build / ps",
          "x": 30,
          "y": 170,
          "w": 160,
          "h": 86,
          "kind": "client",
          "detail": "Parses commands and calls the Docker API. It is a client, not the engine.",
          "lesson": "client-server-architecture"
        },
        {
          "id": "daemon",
          "label": "dockerd",
          "sub": "API · images · networks · volumes",
          "x": 260,
          "y": 170,
          "w": 190,
          "h": 86,
          "kind": "daemon",
          "detail": "The long-running daemon that owns Docker objects and serves the API.",
          "lesson": "client-server-architecture"
        },
        {
          "id": "containerd",
          "label": "containerd",
          "sub": "container lifecycle",
          "x": 520,
          "y": 170,
          "w": 170,
          "h": 86,
          "kind": "runtime",
          "detail": "Prepares snapshots and delegates execution to an OCI runtime.",
          "lesson": "daemon-containerd-runc"
        },
        {
          "id": "shim",
          "label": "containerd-shim",
          "sub": "supervises the process",
          "x": 750,
          "y": 170,
          "w": 175,
          "h": 86,
          "kind": "runtime",
          "detail": "Keeps the container alive if containerd restarts and reports exit status.",
          "lesson": "daemon-containerd-runc"
        },
        {
          "id": "registry",
          "label": "Registry",
          "sub": "image distribution",
          "x": 520,
          "y": 40,
          "w": 170,
          "h": 76,
          "kind": "registry",
          "detail": "Stores and distributes image manifests and layer blobs.",
          "lesson": "images-containers-registries"
        },
        {
          "id": "layer",
          "label": "Image store",
          "sub": "content-addressed layers",
          "x": 260,
          "y": 330,
          "w": 190,
          "h": 76,
          "kind": "image",
          "detail": "Local layer store. Shared layers are stored once.",
          "lesson": "image-anatomy"
        },
        {
          "id": "container",
          "label": "Container process",
          "sub": "namespaces + cgroups",
          "x": 750,
          "y": 330,
          "w": 175,
          "h": 76,
          "kind": "container",
          "detail": "An isolated process using the host kernel, constrained by cgroups.",
          "lesson": "namespaces-cgroups"
        }
      ],
